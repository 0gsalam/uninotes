/* ============================================
   UNINOTES — DARK THEME (Mobile-First)
   ============================================ */

:root {
    --bg: #0b0d17;
    --surface: #151827;
    --surface-2: #1c2033;
    --border: #262b42;
    --text: #e6e8f0;
    --text-dim: #9ba0b8;
    --primary: #7c5cff;
    --primary-2: #a48dff;
    --primary-glow: rgba(124, 92, 255, 0.35);
    --danger: #ff5c7a;
    --success: #4ade80;
    --radius: 14px;
    --shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
    --topbar-h: 64px;
}

* {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
}

html {
    /* Prevent iOS text resize on orientation change */
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
}

html, body {
    margin: 0;
    padding: 0;
    min-height: 100%;
    background: radial-gradient(1200px 800px at 10% -10%, #221a4a 0%, transparent 60%),
                radial-gradient(900px 600px at 110% 10%, #163c4a 0%, transparent 55%),
                var(--bg);
    color: var(--text);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 16px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    /* Prevent horizontal scroll */
    overflow-x: hidden;
}

body {
    /* Account for iPhone notch */
    padding-bottom: env(safe-area-inset-bottom);
}

a {
    color: var(--primary-2);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
}
a:hover { color: var(--primary); }

/* Focus visible for accessibility */
a:focus-visible,
button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
}

/* ============================================
   APP SHELL
   ============================================ */

.app-shell {
    min-height: 100vh;
    min-height: 100dvh; /* dynamic viewport height for mobile */
    display: flex;
    flex-direction: column;
}

/* ============================================
   TOPBAR
   ============================================ */

.topbar {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    padding-top: max(12px, env(safe-area-inset-top));
    background: rgba(18, 21, 34, 0.9);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
    height: var(--topbar-h);
}

.brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--text);
    text-decoration: none;
    min-width: 0;
    flex-shrink: 1;
}

.brand-logo {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
}

.brand-text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.topbar-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
}

/* Hamburger */
.nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
    width: 44px;
    height: 44px;
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 10px;
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
    transition: 0.2s;
}

.nav-toggle:hover { background: var(--surface-2); }

.nav-toggle span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--text);
    border-radius: 2px;
    transition: 0.3s;
}

.nav-toggle[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
}
.nav-toggle[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
}
.nav-toggle[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
}

/* Language switch (mobile top-bar) */
.lang-switch {
    display: flex;
    gap: 4px;
    background: var(--surface);
    padding: 4px;
    border-radius: 10px;
    border: 1px solid var(--border);
}

.lang-switch a {
    padding: 6px 12px;
    border-radius: 7px;
    color: var(--text-dim);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transition: 0.2s;
    display: flex;
    align-items: center;
    gap: 4px;
    min-height: 32px;
}

.lang-switch a:hover { color: var(--text); }
.lang-switch a.active {
    background: var(--primary);
    color: #fff;
}

.lang-switch-mobile { display: none; }
.lang-switch-mobile a {
    font-size: 1.1rem;
    padding: 6px 10px;
}

/* Nav (desktop) */
.nav {
    display: flex;
    align-items: center;
    gap: 8px;
}

.nav > a,
.nav > form > .link-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border-radius: 8px;
    color: var(--text-dim);
    font-weight: 500;
    font-size: 0.95rem;
    transition: 0.2s;
    border: none;
    background: none;
    cursor: pointer;
    font-family: inherit;
}

.nav > a:hover,
.nav > form > .link-btn:hover {
    color: var(--text);
    background: var(--surface);
}

.nav-icon { display: none; }

.nav-divider {
    display: none;
    height: 1px;
    background: var(--border);
    margin: 8px 0;
}

.nav-cta {
    padding: 8px 14px !important;
    font-size: 0.9rem !important;
}

.logout-form { display: contents; }

/* Overlay */
.nav-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    z-index: 90;
    opacity: 0;
    transition: opacity 0.3s;
}
.nav-overlay.open {
    display: block;
    opacity: 1;
}

/* ============================================
   MAIN CONTENT
   ============================================ */

.main-content {
    flex: 1;
    max-width: 1180px;
    width: 100%;
    margin: 0 auto;
    padding: 24px 16px;
}

.footer {
    border-top: 1px solid var(--border);
    padding: 16px;
    color: var(--text-dim);
    font-size: 0.8rem;
    text-align: center;
}

/* ============================================
   BUTTONS — Touch-friendly (min 44px)
   ============================================ */

.btn-primary, .btn-secondary, .btn-danger,
.btn-primary-sm, .link-btn, .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 12px 20px;
    border-radius: 10px;
    border: 1px solid transparent;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: 0.15s;
    text-decoration: none;
    min-height: 44px;
    -webkit-user-select: none;
    user-select: none;
}

.btn-primary, .btn-primary-sm {
    background: linear-gradient(135deg, var(--primary), #5a3ee0);
    color: #fff;
    box-shadow: 0 6px 18px var(--primary-glow);
}
.btn-primary:active, .btn-primary-sm:active {
    transform: scale(0.97);
}

.btn-secondary {
    background: var(--surface);
    color: var(--text);
    border-color: var(--border);
}
.btn-secondary:active { background: var(--surface-2); transform: scale(0.97); }

.btn-danger {
    background: rgba(255, 92, 122, 0.15);
    color: var(--danger);
    border-color: rgba(255, 92, 122, 0.4);
}
.btn-danger:active { background: var(--danger); color: #fff; transform: scale(0.97); }

.btn-primary-sm { padding: 8px 14px; font-size: 0.9rem; min-height: 40px; }

.link-btn {
    background: none;
    border: none;
    color: var(--text-dim);
    padding: 8px 12px;
    min-height: 44px;
}

.icon-btn {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 10px 12px;
    font-size: 1rem;
    min-width: 44px;
}

/* ============================================
   TYPOGRAPHY
   ============================================ */

.page-title {
    font-size: clamp(1.5rem, 5vw, 2.2rem);
    margin: 0 0 8px;
    line-height: 1.2;
    background: linear-gradient(120deg, #fff, #b8a7ff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}
.page-subtitle { color: var(--text-dim); margin: 0 0 20px; font-size: 0.95rem; }

.page-header {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 20px;
}

.section-title {
    margin: 24px 0 14px;
    font-size: 1.15rem;
}

/* ============================================
   DASHBOARD STATS
   ============================================ */

.stat-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin: 20px 0 8px;
}

.stat-card {
    background: linear-gradient(160deg, var(--surface), var(--surface-2));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    text-align: center;
    box-shadow: var(--shadow);
}

.stat-value {
    font-size: 2rem;
    font-weight: 800;
    background: linear-gradient(120deg, var(--primary-2), #63e6be);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
}
.stat-label {
    color: var(--text-dim);
    font-size: 0.85rem;
    margin-top: 8px;
}

/* ============================================
   NOTES GRID
   ============================================ */

.notes-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
}

.note-card {
    display: flex;
    flex-direction: column;
    background: linear-gradient(160deg, var(--surface), #10131f);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
    transition: 0.2s;
    box-shadow: var(--shadow);
    color: var(--text);
    min-height: 120px;
}

.note-card:active {
    transform: scale(0.98);
    border-color: var(--primary);
}

.note-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 8px;
    gap: 8px;
}

.note-card h3 {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.3;
    word-break: break-word;
}
.note-title {
    color: var(--text);
    font-weight: 600;
    flex: 1;
}

.note-excerpt {
    color: var(--text-dim);
    font-size: 0.9rem;
    margin: 8px 0;
    flex: 1;
    white-space: pre-wrap;
    word-break: break-word;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
}

.note-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 10px;
    font-size: 0.75rem;
    color: var(--text-dim);
    flex-wrap: wrap;
    gap: 8px;
}

.note-date { color: var(--text-dim); font-size: 0.75rem; }

.note-actions {
    display: flex;
    gap: 4px;
}
.note-actions a {
    font-size: 0.85rem;
    padding: 8px 12px;
    border-radius: 8px;
    min-height: 40px;
    display: inline-flex;
    align-items: center;
}
.note-actions a:active { background: var(--surface-2); }
.note-actions .danger { color: var(--danger); }

.inline { display: inline; }

/* Chips & tags */
.chip {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid var(--primary);
    color: var(--primary-2);
    font-size: 0.75rem;
    font-weight: 600;
    margin-bottom: 6px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
}

.tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 8px 0;
}
.tag {
    font-size: 0.75rem;
    color: var(--text-dim);
    background: var(--surface-2);
    padding: 4px 10px;
    border-radius: 6px;
}

/* ============================================
   FILTER BAR
   ============================================ */

.filter-bar {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 18px;
    padding: 14px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
}

.filter-bar input[type="text"],
.filter-bar select {
    width: 100%;
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 12px 14px;
    border-radius: 10px;
    font: inherit;
    font-size: 16px; /* iOS: prevent zoom on focus */
    min-height: 44px;
    transition: 0.2s;
}

.filter-bar input[type="text"]:focus,
.filter-bar select:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-glow);
}

.filter-bar .checkbox {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-dim);
    min-height: 44px;
    cursor: pointer;
}
.filter-bar .checkbox input {
    width: 20px;
    height: 20px;
    cursor: pointer;
}

.filter-bar button {
    width: 100%;
}

/* ============================================
   FORMS
   ============================================ */

.form-card, .detail-card, .confirm-card {
    background: linear-gradient(160deg, var(--surface), #0f1220);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px 16px;
    box-shadow: var(--shadow);
    width: 100%;
}

.form-group { margin-bottom: 18px; }

.form-group label {
    display: block;
    margin-bottom: 8px;
    color: var(--text-dim);
    font-size: 0.9rem;
    font-weight: 500;
}

.form-control {
    width: 100%;
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 12px 14px;
    border-radius: 10px;
    font: inherit;
    font-size: 16px; /* iOS: prevent zoom on focus */
    min-height: 44px;
    transition: 0.2s;
}

.form-control:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-glow);
}

textarea.form-control {
    resize: vertical;
    min-height: 150px;
    font-family: inherit;
    line-height: 1.6;
}

.color-input {
    padding: 6px;
    height: 50px;
    cursor: pointer;
}

.form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
}

.form-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 20px;
}
.form-actions .btn-primary,
.form-actions .btn-secondary {
    width: 100%;
}

.checkbox-group label {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    cursor: pointer;
    min-height: 44px;
    padding: 4px 0;
}
.checkbox-group input[type="checkbox"] {
    width: 22px;
    height: 22px;
    cursor: pointer;
    flex-shrink: 0;
}

.text-danger { color: var(--danger); font-size: 0.85rem; }

/* ============================================
   COURSES
   ============================================ */

.course-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
}

.course-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: 0.2s;
}

.course-card:active { background: var(--surface-2); }

.course-card h3 {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.3;
    word-break: break-word;
}
.course-card small { color: var(--text-dim); display: block; margin-top: 4px; }

.course-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    color: var(--text-dim);
    flex-wrap: wrap;
    gap: 8px;
}

.course-meta .note-actions {
    margin-left: auto;
}

/* ============================================
   DETAIL PAGE
   ============================================ */

.detail-header {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 16px;
}
.detail-header h1 {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.3;
    word-break: break-word;
}
.detail-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}
.detail-actions .btn-secondary,
.detail-actions .btn-danger {
    flex: 1;
    min-width: 120px;
}

.detail-content {
    white-space: pre-wrap;
    word-break: break-word;
    margin: 16px 0;
    padding: 16px;
    background: var(--surface-2);
    border-radius: 12px;
    border: 1px solid var(--border);
    line-height: 1.7;
    font-size: 0.95rem;
}

.detail-meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--text-dim);
    font-size: 0.8rem;
    margin-top: 16px;
}

.back-link {
    display: inline-flex;
    align-items: center;
    margin-top: 20px;
    padding: 10px 0;
    min-height: 44px;
}

/* ============================================
   HERO / WELCOME
   ============================================ */

.hero {
    text-align: center;
    padding: 60px 20px;
    max-width: 640px;
    margin: 0 auto;
}
.hero h1 {
    font-size: clamp(1.8rem, 8vw, 3.2rem);
    margin: 0 0 16px;
    line-height: 1.15;
    background: linear-gradient(120deg, #fff, var(--primary-2), #63e6be);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}
.hero p {
    color: var(--text-dim);
    font-size: 1rem;
    margin-bottom: 24px;
}
.hero .btn-primary { width: 100%; max-width: 320px; }

.empty {
    color: var(--text-dim);
    text-align: center;
    padding: 40px 20px;
    background: var(--surface);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
}

.warning { color: var(--danger); margin: 8px 0 20px; }

/* ============================================
   AUTH PAGES
   ============================================ */

.auth-page {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px 16px;
    padding-top: max(24px, env(safe-area-inset-top));
    padding-bottom: max(24px, env(safe-area-inset-bottom));
    position: relative;
}

.auth-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--text);
    margin-bottom: 24px;
    text-decoration: none;
}
.auth-brand .brand-logo { width: 40px; height: 40px; }

.auth-lang {
    position: absolute;
    top: max(16px, env(safe-area-inset-top));
    right: 16px;
    display: flex;
    gap: 4px;
    background: var(--surface);
    padding: 4px;
    border-radius: 10px;
    border: 1px solid var(--border);
}
.auth-lang a {
    padding: 8px 14px;
    border-radius: 7px;
    color: var(--text-dim);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    min-height: 40px;
    display: inline-flex;
    align-items: center;
}
.auth-lang a.active { background: var(--primary); color: #fff; }

.auth-card {
    background: linear-gradient(160deg, var(--surface), #0f1220);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 28px 20px;
    box-shadow: var(--shadow);
    width: 100%;
    max-width: 440px;
}

.auth-title {
    margin: 0 0 6px;
    font-size: 1.5rem;
    background: linear-gradient(120deg, #fff, #b8a7ff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}
.auth-subtitle {
    color: var(--text-dim);
    margin: 0 0 20px;
    font-size: 0.9rem;
}

.auth-form .form-group { margin-bottom: 16px; }
.auth-submit {
    width: 100%;
    padding: 14px;
    font-size: 1rem;
    margin-top: 8px;
}
.auth-links {
    margin-top: 16px;
    text-align: center;
    font-size: 0.9rem;
    color: var(--text-dim);
}
.auth-links a { color: var(--primary-2); font-weight: 500; }

.auth-back {
    margin-top: 20px;
    color: var(--text-dim);
    font-size: 0.9rem;
    text-decoration: none;
    padding: 10px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
}

/* ============================================
   TABLET — min 640px
   ============================================ */

@media (min-width: 640px) {
    .main-content { padding: 32px 24px; }
    .topbar { padding: 14px 24px; }
    .brand-text { font-size: 1.15rem; }

    .stat-grid { grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .notes-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .course-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; }

    .page-header {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }

    .filter-bar {
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
    }
    .filter-bar input[type="text"],
    .filter-bar select {
        width: auto;
        min-width: 140px;
        flex: 1;
    }
    .filter-bar button { width: auto; }

    .form-row { grid-template-columns: 1fr 1fr; }
    .form-card, .detail-card, .confirm-card { padding: 26px; }

    .form-actions { flex-direction: row; }
    .form-actions .btn-primary,
    .form-actions .btn-secondary { width: auto; }

    .detail-header { flex-direction: row; justify-content: space-between; }
    .detail-actions .btn-secondary,
    .detail-actions .btn-danger { flex: 0 0 auto; }
    .detail-meta { flex-direction: row; gap: 18px; }

    .auth-card { padding: 36px 32px; }
    .auth-title { font-size: 1.7rem; }
}

/* ============================================
   DESKTOP — min 960px
   ============================================ */

@media (min-width: 960px) {
    .notes-grid { grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
    .course-grid { grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
}

/* ============================================
   MOBILE NAVIGATION — max 959px
   ============================================ */

@media (max-width: 959px) {
    .nav-toggle { display: flex; }
    .lang-switch-desktop { display: none; }
    .lang-switch-mobile { display: flex; }

    .topbar {
        flex-wrap: nowrap;
    }

    .nav {
        position: fixed;
        top: var(--topbar-h);
        right: 0;
        bottom: 0;
        width: min(320px, 85vw);
        background: var(--surface);
        border-left: 1px solid var(--border);
        flex-direction: column;
        align-items: stretch;
        gap: 4px;
        padding: 20px 16px;
        padding-bottom: max(20px, env(safe-area-inset-bottom));
        transform: translateX(100%);
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        z-index: 95;
        box-shadow: -10px 0 30px rgba(0, 0, 0, 0.4);
    }

    .nav.open {
        transform: translateX(0);
    }

    .nav > a,
    .nav > form,
    .nav > form > .link-btn {
        width: 100%;
    }

    .nav > a,
    .nav > form > .link-btn {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 16px;
        font-size: 1rem;
        border-radius: 10px;
        min-height: 52px;
        justify-content: flex-start;
    }

    .nav > a:hover,
    .nav > form > .link-btn:hover {
        background: var(--surface-2);
    }

    .nav > a.active {
        background: var(--surface-2);
        color: var(--text);
    }

    .nav-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        width: 28px;
        flex-shrink: 0;
    }

    .nav-cta {
        justify-content: center !important;
        margin-top: 8px;
        width: 100%;
    }

    .nav-divider {
        display: block;
        margin: 12px 0;
    }

    .nav .lang-switch {
        width: 100%;
        justify-content: center;
        padding: 6px;
    }
    .nav .lang-switch a {
        flex: 1;
        justify-content: center;
        min-height: 40px;
    }

    .logout-form { display: block; }

    /* Landing page text scale */
    .hero { padding: 48px 20px; }
}

/* ============================================
   VERY SMALL — max 380px
   ============================================ */

@media (max-width: 380px) {
    .brand-text { font-size: 1rem; }
    .brand-logo { width: 28px; height: 28px; }
    .topbar { padding: 10px 12px; --topbar-h: 56px; }
    .main-content { padding: 16px 12px; }

    .nav > a, .nav > form > .link-btn {
        padding: 12px 14px;
        font-size: 0.95rem;
    }

    .stat-value { font-size: 1.6rem; }
}

/* ============================================
   iOS INPUTS — prevent auto zoom & fix appearance
   ============================================ */

@supports (-webkit-touch-callout: none) {
    input, textarea, select {
        font-size: 16px !important;
    }
}

/* Remove default iOS input styling */
input[type="text"],
input[type="email"],
input[type="password"],
input[type="search"],
input[type="tel"],
input[type="url"],
input[type="number"],
textarea,
select {
    -webkit-appearance: none;
    appearance: none;
    background-clip: padding-box;
}

/* Date/time picker on dark theme */
input[type="date"]::-webkit-calendar-picker-indicator,
input[type="datetime-local"]::-webkit-calendar-picker-indicator {
    filter: invert(1);
    cursor: pointer;
}

/* Autofill on dark theme */
input:-webkit-autofill,
input:-webkit-autofill:hover,
input:-webkit-autofill:focus,
textarea:-webkit-autofill {
    -webkit-box-shadow: 0 0 0 1000px var(--surface-2) inset !important;
    -webkit-text-fill-color: var(--text) !important;
    transition: background-color 5000s ease-in-out 0s;
}

/* ============================================
   SCROLLBAR (desktop only)
   ============================================ */

@media (min-width: 960px) {
    ::-webkit-scrollbar { width: 10px; height: 10px; }
    ::-webkit-scrollbar-track { background: var(--bg); }
    ::-webkit-scrollbar-thumb {
        background: var(--surface-2);
        border-radius: 5px;
    }
    ::-webkit-scrollbar-thumb:hover { background: var(--border); }
}

/* ============================================
   REDUCED MOTION
   ============================================ */

@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
    }
}

/* ============================================
   LANDSCAPE PHONE
   ============================================ */

@media (max-height: 500px) and (orientation: landscape) {
    .auth-page { padding: 16px; justify-content: flex-start; }
    .auth-brand { margin-bottom: 12px; }
    .auth-card { padding: 20px; }
}