@model UniNotes.ViewModels.NoteFormViewModel

<form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post" class="form-card">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="Title">@Localizer["Title"]</label>
        <input asp-for="Title" class="form-control" autocomplete="off" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Content">@Localizer["Content"]</label>
        <textarea asp-for="Content" class="form-control" rows="10"></textarea>
        <span asp-validation-for="Content" class="text-danger"></span>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label asp-for="CourseId">@Localizer["Course"]</label>
            <select asp-for="CourseId" asp-items="Model.Courses" class="form-control">
                <option value="">—</option>
            </select>
        </div>

        <div class="form-group">
            <label asp-for="Tags">@Localizer["Tags"]</label>
            <input asp-for="Tags" class="form-control" placeholder="@Localizer["TagsHint"]" autocomplete="off" />
        </div>
    </div>

    <div class="form-group checkbox-group">
        <label>
            <input asp-for="IsPinned" />
            <span>@Localizer["Pinned"]</span>
        </label>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn-primary">@Localizer["Save"]</button>
        <a asp-action="Index" class="btn-secondary">@Localizer["Cancel"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}