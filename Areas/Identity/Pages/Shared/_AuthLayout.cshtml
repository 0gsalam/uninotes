@using System.Globalization
@{
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>@ViewData["Title"] — @Localizer["AppName"]</title>
    @* <link rel="icon" type="image/svg+xml" href="~/img/logo.svg" /> *@
        @*/////Icon////*@

        <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
        <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" />
        <link rel="manifest" href="~/site.webmanifest" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <div class="auth-page">

        <a class="auth-brand" asp-controller="Home" asp-action="Index" asp-area="">
            @* <span class="brand-logo">📘</span> *@
            <img src="~/android-chrome-512x512.png" alt="Logo" class="brand-logo" />
            <span class="brand-text">@Localizer["AppName"]</span>
        </a>

        <div class="auth-lang">
            <a href="/Language/Set?culture=bg&returnUrl=@returnUrl"
               class="@(currentCulture == "bg" ? "active" : "")">🇧🇬 BG</a>
            <a href="/Language/Set?culture=en&returnUrl=@returnUrl"
               class="@(currentCulture == "en" ? "active" : "")">🇬🇧 EN</a>
        </div>

        <div class="auth-card">
            @RenderBody()
        </div>

        <a class="auth-back" asp-controller="Home" asp-action="Index" asp-area="">
            ← @Localizer["Home"]
        </a>

    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>